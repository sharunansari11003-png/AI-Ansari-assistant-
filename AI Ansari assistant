<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI ANSARI ASSISTANT</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: #070b14; color: #fff; display: flex; flex-direction: column; height: 100vh; }
    header { background: #0f172a; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; box-shadow: 0 0 15px rgba(56, 189, 248, 0.2); }
    header h1 { font-size: 18px; color: #38bdf8; text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); }
    #chat-container { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .msg { max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 14px; line-height: 1.4; word-break: break-word; }
    .user { align-self: flex-end; background: #0284c7; color: #fff; border-bottom-right-radius: 2px; }
    .ai { align-self: flex-start; background: #111827; color: #e2e8f0; border-bottom-left-radius: 2px; border: 1px solid #1f2937; }
    .msg img { max-width: 100%; border-radius: 8px; margin-top: 6px; display: block; }
    #preview-area { padding: 4px 16px; display: none; align-items: center; gap: 10px; background: #0f172a; }
    #img-preview { width: 45px; height: 45px; object-fit: cover; border-radius: 6px; }
    #remove-img { background: #ef4444; border: none; color: #fff; border-radius: 50%; width: 20px; height: 20px; font-size: 12px; cursor: pointer; }
    footer { background: #0f172a; padding: 10px; display: flex; align-items: center; gap: 8px; border-top: 1px solid #1e293b; }
    .file-btn { background: #1e293b; border: 1px solid #334155; color: #fff; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 16px; }
    #userInput { flex: 1; background: #070b14; border: 1px solid #334155; color: #fff; padding: 10px; border-radius: 8px; font-size: 14px; outline: none; }
    .send-btn { background: #38bdf8; border: none; color: #070b14; font-weight: bold; padding: 10px 16px; border-radius: 8px; cursor: pointer; box-shadow: 0 0 10px rgba(56, 189, 248, 0.4); }
  </style>
</head>
<body>

  <header>
    <h1>AI ANSARI ASSISTANT</h1>
  </header>

  <div id="chat-container"></div>

  <div id="preview-area">
    <img id="img-preview" src="">
    <button id="remove-img" onclick="clearImage()">✕</button>
    <span style="font-size: 12px; color: #94a3b8;">फोटो चुनी गई</span>
  </div>

  <footer>
    <label class="file-btn">
      📷
      <input type="file" id="fileInput" accept="image/*" style="display:none" onchange="handleImage(event)">
    </label>
    <input type="text" id="userInput" placeholder="पूछें, फोटो भेजें या कहें 'कॉल 987...'" onkeydown="if(event.key==='Enter') sendMsg()">
    <button class="send-btn" onclick="sendMsg()">भेजें</button>
  </footer>

  <script>
    const API_KEY = "AQ.Ab8RN6K4cXRj1fGxxbIxY__BxYH4nD9uL1N9mQOQesI3jc-zdw";
    let chatHistory = JSON.parse(localStorage.getItem('my_chat_history') || '[]');
    let currentBase64Image = null;

    function renderChat() {
      const container = document.getElementById('chat-container');
      container.innerHTML = '';
      chatHistory.forEach(item => {
        const msgDiv = document.createElement('div');
        msgDiv.className = `msg ${item.role}`;
        msgDiv.innerText = item.text;
        if (item.image) {
          const img = document.createElement('img');
          img.src = item.image;
          msgDiv.appendChild(img);
        }
        container.appendChild(msgDiv);
      });
      container.scrollTop = container.scrollHeight;
    }
    renderChat();

    function handleImage(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        currentBase64Image = evt.target.result;
        document.getElementById('img-preview').src = currentBase64Image;
        document.getElementById('preview-area').style.display = 'flex';
      };
      reader.readAsDataURL(file);
    }

    function clearImage() {
      currentBase64Image = null;
      document.getElementById('fileInput').value = '';
      document.getElementById('preview-area').style.display = 'none';
    }

    async function sendMsg() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();

      if (!text && !currentBase64Image) return;

      const callMatch = text.match(/कॉल\s*(\+?\d+)/i) || text.match(/call\s*(\+?\d+)/i);
      if (callMatch) {
        const phone = callMatch[1];
        chatHistory.push({ role: 'user', text: text });
        chatHistory.push({ role: 'ai', text: `नंबर ${phone} पर कॉल मिलाई जा रही है...` });
        saveAndRefresh();
        input.value = '';
        window.location.href = `tel:${phone}`;
        return;
      }

      const userMsgObj = { role: 'user', text: text, image: currentBase64Image };
      chatHistory.push(userMsgObj);
      saveAndRefresh();

      const promptText = text;
      const sentImage = currentBase64Image;
      input.value = '';
      clearImage();

      try {
        const aiResponse = await callGemini(API_KEY, promptText, sentImage);
        chatHistory.push({ role: 'ai', text: aiResponse });
        saveAndRefresh();
      } catch (err) {
        chatHistory.push({ role: 'ai', text: 'माफ़ करें, कोई त्रुटि हुई: ' + err.message });
        saveAndRefresh();
      }
    }

    function saveAndRefresh() {
      localStorage.setItem('my_chat_history', JSON.stringify(chatHistory));
      renderChat();
    }

    async function callGemini(key, text, base64Img) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=${key}`;
      
      const parts = [];
      if (text) parts.push({ text: text });
      if (base64Img) {
        const base64Data = base64Img.split(',')[1];
        const mimeType = base64Img.split(';')[0].split(':')[1];
        parts.push({
          inline_data: {
            mime_type: mimeType,
            data: base64Data
          }
        });
      }

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents: [{ parts: parts }] })
      });

      const data = await res.json();
      if (data.error) throw new Error(data.error.message);
      return data.candidates[0].content.parts[0].text;
    }
  </script>
</body>
</html>
